#!/usr/bin/env bash
set -Eeuo pipefail

ACTION="${1:-}"
FREERADIUS_BIN="$(command -v freeradius || command -v radiusd || true)"
RS_IP="${RS_RADIUS_IP:-10.78.0.1}"
SERVICE="freeradius"

[[ "$(id -u)" -eq 0 ]] || { echo "This helper must run as root." >&2; exit 1; }
[[ -n "$FREERADIUS_BIN" ]] || { echo "FreeRADIUS is not installed." >&2; exit 1; }

validate_config() {
  "$FREERADIUS_BIN" -XC >/tmp/rs-radius-config-check.log 2>&1 || {
    tail -n 120 /tmp/rs-radius-config-check.log >&2
    return 1
  }
}

assert_no_public_radius() {
  local public
  public="$(ss -H -lunp 2>/dev/null | awk '$4 ~ /^(0\.0\.0\.0|\*|\[::\]):(1812|1813)$/ {print}')"
  [[ -z "$public" ]] || {
    echo "Public RADIUS listeners detected; refusing unsafe state." >&2
    echo "$public" >&2
    return 1
  }
}

assert_rs_listeners() {
  local auth acct
  auth="$(ss -H -lunp 2>/dev/null | awk -v ep="${RS_IP}:1812" '$4 == ep {n++} END {print n+0}')"
  acct="$(ss -H -lunp 2>/dev/null | awk -v ep="${RS_IP}:1813" '$4 == ep {n++} END {print n+0}')"
  [[ "$auth" -eq 1 ]] || { echo "Expected exactly one ${RS_IP}:1812 listener, found $auth." >&2; return 1; }
  [[ "$acct" -eq 1 ]] || { echo "Expected exactly one ${RS_IP}:1813 listener, found $acct." >&2; return 1; }
}

restart_radius() {
  validate_config
  systemctl restart "$SERVICE"
  systemctl is-active --quiet "$SERVICE" || {
    journalctl -u "$SERVICE" -n 120 --no-pager >&2 || true
    return 1
  }
  sleep 1
  assert_no_public_radius
  assert_rs_listeners
  echo "FreeRADIUS v6-compatible runtime reloaded on ${RS_IP}:1812/1813."
}

case "$ACTION" in
  reload|restart)
    restart_radius
    ;;
  check)
    validate_config
    systemctl is-active --quiet "$SERVICE" || { echo "$SERVICE is not active." >&2; exit 1; }
    assert_no_public_radius
    assert_rs_listeners
    echo "FreeRADIUS v6-compatible configuration, service and private listeners are healthy."
    ;;
  status)
    echo "mode=v6-default"
    echo "service=$SERVICE"
    echo "config=/etc/freeradius/3.0"
    systemctl is-active "$SERVICE" || true
    systemctl is-enabled "$SERVICE" 2>/dev/null || true
    ss -H -lunp 2>/dev/null | awk '$4 ~ /:(1812|1813|18120)$/ {print}'
    ;;
  *)
    echo "Usage: $0 {reload|restart|check|status}" >&2
    exit 2
    ;;
esac
