#!/usr/bin/env bash
set -Eeuo pipefail

ACTION="${1:-}"
PUBLIC_KEY="${2:-}"
TUNNEL_IP="${3:-}"
CONFIG_FILE="${NUXHOST_WIREGUARD_CONFIG:-/etc/nuxhost/wireguard.ini}"

if [[ "$(id -u)" -ne 0 ]]; then
    echo "This helper must run as root." >&2
    exit 1
fi

read_config_value() {
    local key="$1"
    awk -F= -v wanted="$key" '
        /^[[:space:]]*[#;]/ { next }
        NF >= 2 {
            k=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
            if (k == wanted) {
                $1=""; sub(/^=/, "", $0); gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
                print $0; exit
            }
        }
    ' "$CONFIG_FILE"
}

[[ -r "$CONFIG_FILE" ]] || {
    echo "WireGuard public configuration is missing: $CONFIG_FILE" >&2
    exit 1
}

WG_INTERFACE="${NUXHOST_WG_INTERFACE:-$(read_config_value interface)}"
WG_CIDR="${NUXHOST_WG_CIDR:-$(read_config_value cidr)}"
WG_SERVER_IP="${NUXHOST_WG_SERVER_IP:-$(read_config_value server_ip)}"
WG_CONF="/etc/wireguard/${WG_INTERFACE}.conf"

validate_runtime() {
    [[ "$WG_INTERFACE" =~ ^[A-Za-z0-9_.-]{1,80}$ ]] || {
        echo "Invalid WireGuard interface." >&2
        exit 1
    }
    [[ -f "$WG_CONF" ]] || {
        echo "WireGuard configuration not found: $WG_CONF" >&2
        exit 1
    }
    wg show "$WG_INTERFACE" >/dev/null 2>&1 || {
        echo "WireGuard interface is not active: $WG_INTERFACE" >&2
        exit 1
    }
}

validate_peer() {
    [[ "$PUBLIC_KEY" =~ ^[A-Za-z0-9+/]{43}=$ ]] || {
        echo "Invalid WireGuard public key." >&2
        exit 1
    }

    python3 - "$TUNNEL_IP" "$WG_CIDR" "$WG_SERVER_IP" <<'PY'
import ipaddress
import sys
ip = ipaddress.ip_address(sys.argv[1])
network = ipaddress.ip_network(sys.argv[2], strict=False)
server = ipaddress.ip_address(sys.argv[3])
if ip.version != 4 or network.version != 4 or ip not in network or ip == server:
    raise SystemExit(1)
PY
}

activate_peer() {
    validate_runtime
    validate_peer

    export PUBLIC_KEY TUNNEL_IP WG_CONF
    python3 <<'PY'
import os
import re
import tempfile
from pathlib import Path

path = Path(os.environ['WG_CONF'])
public_key = os.environ['PUBLIC_KEY']
allowed_ip = os.environ['TUNNEL_IP'] + '/32'
text = path.read_text()

# Preserve the Interface section exactly, including its private key and every
# unrelated peer. Replace only a peer with this same public key or /32 address.
parts = re.split(r'(?m)(?=^\[Peer\]\s*$)', text)
interface = parts[0].rstrip() + '\n'
kept = []
for block in parts[1:]:
    key_match = re.search(r'(?mi)^\s*PublicKey\s*=\s*(\S+)\s*$', block)
    ips_match = re.search(r'(?mi)^\s*AllowedIPs\s*=\s*(.+?)\s*$', block)
    key = key_match.group(1).strip() if key_match else ''
    ips = [item.strip() for item in ips_match.group(1).split(',')] if ips_match else []
    if key == public_key or allowed_ip in ips:
        continue
    kept.append(block.rstrip() + '\n')

peer = f'''\n[Peer]\nPublicKey = {public_key}\nAllowedIPs = {allowed_ip}\n'''
new_text = interface + ''.join('\n' + block for block in kept).rstrip() + peer

fd, temp_name = tempfile.mkstemp(prefix=path.name + '.', dir=str(path.parent))
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as handle:
        handle.write(new_text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp_name, path)
finally:
    if os.path.exists(temp_name):
        os.unlink(temp_name)
PY

    STRIPPED="$(mktemp)"
    trap 'rm -f "$STRIPPED"' RETURN
    wg-quick strip "$WG_INTERFACE" >"$STRIPPED"
    wg syncconf "$WG_INTERFACE" "$STRIPPED"
    rm -f "$STRIPPED"
    trap - RETURN

    wg show "$WG_INTERFACE" allowed-ips |
        awk -v key="$PUBLIC_KEY" -v ip="$TUNNEL_IP/32" '$1 == key && $2 == ip { found=1 } END { exit found ? 0 : 1 }' || {
            echo "WireGuard peer verification failed." >&2
            exit 1
        }

    echo "WireGuard peer activated for ${TUNNEL_IP}."
}

allocated_ips() {
    validate_runtime
    wg show "$WG_INTERFACE" allowed-ips |
        awk '{for (i=2;i<=NF;i++) print $i}' |
        tr ',' '\n' |
        sed -E 's/^[[:space:]]+|[[:space:]]+$//g' |
        awk 'NF && $0 ~ /\/32$/ {print}'
}

case "$ACTION" in
    activate)
        activate_peer
        ;;
    allocated)
        allocated_ips
        ;;
    check)
        validate_runtime
        echo "WireGuard management interface is ready."
        ;;
    *)
        echo "Usage: $0 {activate PUBLIC_KEY TUNNEL_IP|allocated|check}" >&2
        exit 2
        ;;
esac
